{
  "name": "mistwood",
  "productName": "Mistwood",
  "version": "0.1.0",
  "private": true,
  "description": "迷霧之森：星光旅人",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm typecheck && pnpm build:web && pnpm build:electron",
    "dist": "pnpm build && electron-builder",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "screenshot": "pnpm build && node scripts/screenshot.mjs",
    "data:placements": "node scripts/gen-placements.ts",
    "pack": "pnpm build && electron-builder --dir",
    "e2e": "pnpm build && node e2e/movement.e2e.mjs && node e2e/world.e2e.mjs && node e2e/harvest.e2e.mjs && node e2e/save.e2e.mjs && node e2e/tutorial.e2e.mjs && node e2e/settings.e2e.mjs && node e2e/region.e2e.mjs && node e2e/npc.e2e.mjs && node e2e/quest.e2e.mjs && node e2e/lake.e2e.mjs && node e2e/combat.e2e.mjs && node e2e/dev.e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.2.0",
    "@react-three/rapier": "2.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "playwright": "1.64.0",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "author": "Mistwood Team"
}
